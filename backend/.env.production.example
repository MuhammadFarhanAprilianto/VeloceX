# ==========================================
# VELOCEX PRODUCTION ENVIRONMENT CONFIG
# ==========================================

# Server Configuration
SERVER_PORT=8080
GIN_MODE=release

# Production Cloud Database (PostgreSQL)
DB_HOST=postgres.your-cloud-provider.com
DB_PORT=5432
DB_USER=velocex_admin
DB_PASSWORD=YourUltraSecureDatabasePasswordHere2026!
DB_NAME=velocex_production_db

# Security & JWT Tokens
JWT_SECRET=Your64CharRandomProductionJWTSecretKeyHere_ABC1234567890XYZ
JWT_EXPIRATION_HOURS=72

# Real Payment Gateway Credentials
# 1. Midtrans / Xendit (Fiat IDR - QRIS & Virtual Accounts)
MIDTRANS_SERVER_KEY=SB-Mid-server-YOUR_REAL_KEY_HERE
MIDTRANS_CLIENT_KEY=SB-Mid-client-YOUR_CLIENT_KEY
XENDIT_SECRET_KEY=xnd_production_YOUR_SECRET_KEY

# 2. NOWPayments / CoinPayments (Crypto On-Chain)
NOWPAYMENTS_API_KEY=YOUR_NOWPAYMENTS_API_KEY_HERE
NOWPAYMENTS_IPN_SECRET=YOUR_IPN_WEBHOOK_SECRET

# Rate Limiting & Anti-DDoS
RATE_LIMIT_RPS=120
RATE_LIMIT_WINDOW_MINUTES=1
